<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的云备份与设备间迁移范围。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
